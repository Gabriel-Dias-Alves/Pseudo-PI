<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <title>mudar cadastro</title>
    </head>

    <body>
        <div class="container">
        <h2>Editar Cadastro</h2>
        <% cadastro.forEach(function(details) { %>
            <form action="/edit/<%= details._id %>" method="POST">
                <input type="text" value="<%= details.nomeCompleto %>" name="nomeCompleto">
                <input type="e-mail" value="<%= details.email %>" name="email">
                <br/>
                <button type="submit">Editar</button>
                <button><a href="/show">Todos os Cadastros</a></button>
            </form>
        </div>
        <% }) %>
    </body>

</html>