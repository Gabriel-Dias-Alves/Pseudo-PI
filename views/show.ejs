<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Cadastro</title>
</head>

<body><div class="container"></div>
    <h2>Cadastro</h2>
    <div class="card"></div>
    <link rel="stylesheet" href="/style.css">
    <table border="1">
        
        <thead>
            <tr>
                <td>Nome Completo</td>
                <td>E-mail</td>
                <td>Ação</td>
            </tr>
        </thead>
        <tbody>
            <% cadastro.forEach(function(details) { %>
                <tr>
                    <td><%= details.nomeCompleto %></td>
                    <td><%= details.email %></td>
                    
                    <td><a href="/edit/<%= details._id %>">Alterar</a> - 
                        <a href="/delete/<%= details._id %>">Deletar</a></td>
                </tr>
                <% }) %>
        </tbody>
    </table> <button><a href="/index">Criar Novo Cadastro</a></button>
</body>

</html>